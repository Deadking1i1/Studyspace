# Study Space local environment example
SECRET_KEY=replace-with-a-secure-random-string
DATABASE_URL=database.db
FLASK_DEBUG=1
FLASK_ENV=development
RATELIMIT_STORAGE_URI=memory://
AUTH_REGISTER_RATE_LIMIT=3 per minute
AUTH_LOGIN_RATE_LIMIT=5 per minute
AUTH_PASSWORD_RESET_RATE_LIMIT=3 per minute
TRUST_PROXY_HEADERS=false
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Study Space <accounts@example.com>
UPLOAD_SCANNER_URL=
UPLOAD_SCANNER_TOKEN=
PRIVATE_BETA_ENABLED=false
BETA_ALLOWED_EMAILS=
PDF_ALLOWED_DOMAINS=
APP_BASE_URL=http://127.0.0.1:5000
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=

# Future AI assistant integration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Spotify integration (server-side only; never use NEXT_PUBLIC_ variables)
# Register this exact local redirect URI in the Spotify Dashboard:
# http://127.0.0.1:3000/integrations/spotify/callback
# Production uses an exact HTTPS callback such as:
# https://studyspace.example.com/integrations/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/integrations/spotify/callback
SPOTIFY_ENABLED=true

# Future Google OAuth / Calendar / Drive integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/integrations/google/callback
GOOGLE_OAUTH_SCOPES=openid,email,profile,https://www.googleapis.com/auth/calendar.events,https://www.googleapis.com/auth/drive.file

# Local development uses local storage. Production requires private S3/R2-compatible storage.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_FORCE_PATH_STYLE=false
NEXT_PUBLIC_STUDY_SPACE_COMMUNITY_ENABLED=false

# TypeScript/Next migration stack
# Keep this separate from Flask DATABASE_URL while Flask is still using SQLite locally.
STUDY_SPACE_DATABASE_URL=postgresql://study_space:study_space@localhost:5432/study_space
STUDY_SPACE_APP_BASE_URL=http://127.0.0.1:3000
AUTH_SECRET=replace-with-a-secure-random-string-for-next
AUTH_REGISTER_RATE_LIMIT=3 per minute
AUTH_LOGIN_RATE_LIMIT=5 per minute
AUTH_PASSWORD_RESET_RATE_LIMIT=3 per minute
TRUST_PROXY_HEADERS=false
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Study Space <accounts@example.com>
UPLOAD_SCANNER_URL=
UPLOAD_SCANNER_TOKEN=
PRIVATE_BETA_ENABLED=false
BETA_ALLOWED_EMAILS=
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
SPOTIFY_ENABLED=true
NEXT_PUBLIC_STUDY_SPACE_COMMUNITY_ENABLED=false
